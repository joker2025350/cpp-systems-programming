# ============================================================
# 全局忽略规则 —— 对本仓库下所有目录生效
# 每行一个匹配模式；以 / 开头表示从仓库根目录算起
# ============================================================

# ---------- 编译产物 ----------
# 机器生成的二进制文件，不是源码，不纳入版本管理
build/
bin/
obj/
*.o
*.obj
*.out
*.a
*.so
*.dll
*.exe
*.pdb
a.out

# 各模块的编译产物统一落在模块目录下的 bin/，由上面的 bin/ 规则覆盖，
# 不需要为每个模块单独列可执行文件名。

# ---------- CMake ----------
CMakeFiles/
CMakeCache.txt
cmake_install.cmake

# ---------- 日志与运行数据 ----------
*.log
logs/
*.bag
*.pcd

# ---------- Python（部分内容可能用脚本辅助）----------
__pycache__/
*.py[cod]
venv/
.venv/

# ---------- 本地凭据（绝不能提交）----------
# mysql-client 的数据库连接参数。仓库里只保留 config.h.example 模板，
# 真实的 config.h 由使用者自己复制生成，不进版本库。
/src/mysql-client/config.h

# ---------- 编辑器与系统文件 ----------
.vscode/
.idea/
*.swp
*.swo
Thumbs.db
Desktop.ini
.DS_Store
