# ============================================================
# 全局忽略规则 —— 对本仓库下所有目录生效
# 每行一个匹配模式；以 / 开头表示从仓库根目录算起
# ============================================================

# ---------- 编译产物 ----------
# 机器生成的二进制文件，不是源码，不纳入版本管理
build/
bin/
obj/
*.o
*.obj
*.out
*.a
*.so
*.dll
*.exe
*.pdb
a.out

# Linux 下的可执行文件通常不带扩展名，无法用通配符匹配，
# 因此只能按路径逐个列出。新增主题目录后在这里补一行。
/01-concurrent-lock/lock

# ---------- CMake ----------
CMakeFiles/
CMakeCache.txt
cmake_install.cmake

# ---------- 日志与运行数据 ----------
*.log
logs/
*.bag
*.pcd

# ---------- Python（部分内容可能用脚本辅助）----------
__pycache__/
*.py[cod]
venv/
.venv/

# ---------- 编辑器与系统文件 ----------
.vscode/
.idea/
*.swp
*.swo
Thumbs.db
Desktop.ini
.DS_Store
