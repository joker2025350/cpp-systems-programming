#ifndef KING_DB_CONFIG_H
#define KING_DB_CONFIG_H

/*
 * 数据库连接配置模板。
 *
 * 使用方式：把本文件复制为同目录下的 config.h，再填入你自己的连接信息。
 * config.h 已在 .gitignore 中被忽略，不会被提交到版本库，
 * 因此凭据不会随源码泄露。
 *
 * 复制命令（Linux / Git Bash）：
 *     cp config.h.example config.h
 */

#define KING_DB_SERVER_IP	"127.0.0.1"
#define KING_DB_SERVER_PORT	3306

#define KING_DB_USERNAME	"your_username"
#define KING_DB_PASSWORD	"your_password"

#define KING_DB_DEFAULTDB	"KING_DB"

#endif /* KING_DB_CONFIG_H */
